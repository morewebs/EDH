{
  "name": "@moreweb/edh",
  "version": "0.6.0",
  "private": true,
  "description": "Everything DeepSeek Harness",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./retry": "./retry.js",
    "./edit": "./edit.js",
    "./btw": "./btw.js",
    "./export": "./export.js",
    "./update": "./update.js",
    "./mcp": "./mcp.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "retry.js",
    "edit.js",
    "btw.js",
    "export.js",
    "update.js",
    "mcp.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  },
  "license": "MIT"
}
